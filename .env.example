# VitalWatch AI local configuration
# Copy to .env in the project root or backend/ and fill in values.
# Never put secrets in frontend code or VITE_* variables.

# API
VITALWATCH_HOST=127.0.0.1
VITALWATCH_PORT=8000
VITALWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./vitalwatch.db

# Demo simulation (synthetic data only)
SIMULATION_INTERVAL_SECONDS=4
STALE_AFTER_SECONDS=20
DEMO_ACTOR=clinician.demo

# Azure AI Foundry — optional, final phase only
# Leave unset to run monitoring without AI costs.
# Configure these values when connecting to your Microsoft Foundry agent.

AZURE_AI_ENABLED=false
AZURE_AI_PROJECT_ENDPOINT=https://vitalwatch-resource.services.ai.azure.com/api/projects/VitalWatch
AZURE_AI_AGENT_ID=quiet-agent-c05jgrxvbx
AZURE_AI_MODEL_DEPLOYMENT=gpt-5.4-mini
AZURE_AI_API_VERSION=v1
# Prefer DefaultAzureCredential / az login in local demo.
# If using an API key locally, keep it server-side only:
AZURE_AI_API_KEY=
